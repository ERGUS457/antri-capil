DATABASE_URL="postgresql://user:pass@host:port/db?sslmode=require"
GMAIL_USER="your-email@gmail.com"
GMAIL_PASS="your-app-password"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin accounts are NOT created over the public registration endpoint any more.
# To create or reset the admin account, choose your own password and run:
#   ADMIN_PASSWORD='<at-least-12-chars>' npm run seed:admin
# There is deliberately no ADMIN_SECRET env var: the old one had a hardcoded
# "capil123" fallback that let anyone mint an admin account (fixed 2026-09-28).
