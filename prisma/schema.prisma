generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Layanan {
  id          String        @id @default(cuid())
  kode        LayananKode   @unique
  nama        String
  deskripsi   String?
  kuotaPerJam Int           @default(10)
  antrean     Antrean[]
  kuota       KuotaHarian[]
}

model Warga {
  id      String    @id @default(cuid())
  nik     String    @unique
  nama    String
  email   String?
  antrean Antrean[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  nik       String?  @unique
  name      String
  password  String
  role      Role   @default(WARGA)
  phone     String?
  privacyAcceptedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  antrean   Antrean[]
}

model Antrean {
  id           String        @id @default(cuid())
  qrToken      String?       @unique @default(cuid())
  nomor        Int
  tanggal      DateTime
  status       StatusAntrean @default(MENUNGGU)
  waktuPanggil DateTime?
  waktuSelesai DateTime?
  waktuLewati  DateTime?
  wargaId      String?
  layananId    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String?
  layanan      Layanan       @relation(fields: [layananId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  warga        Warga?        @relation(fields: [wargaId], references: [id])

  @@unique([layananId, tanggal, nomor])
  @@index([userId])
  @@index([wargaId])
}

model KuotaHarian {
  id        String   @id @default(cuid())
  tanggal   DateTime
  jumlah    Int
  terisi    Int      @default(0)
  layananId String
  layanan   Layanan  @relation(fields: [layananId], references: [id])

  @@unique([layananId, tanggal])
}

enum StatusAntrean {
  MENUNGGU
  DIPANGGIL
  SELESAI
  LEWATI
  BATAL
}

enum LayananKode {
  KTP
  KK
  KIA
  PINDAH
  AKTA
}

enum Role {
  WARGA
  ADMIN
}
